# Database Configuration
POSTGRES_DB=urlshortener
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret

# Spring DataSource Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/urlshortener
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=secret

# JWT Secret (Unit U-003 - Backend Auth)
# IMPORTANT: Change this to a strong random secret in production
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters

# OAuth2 Configuration (Unit U-003 - Backend Auth)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Application Configuration
# SERVER_PORT=8080
# FRONTEND_URL=http://localhost:3000

# GeoIP Configuration (Unit U-001 - Backend Core)
# GEOIP_DATABASE_PATH=/path/to/GeoLite2-City.mmdb

# CORS Configuration (Unit U-001, U-002, U-003)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Note: Copy this file to .env and fill in actual values
# .env is gitignored for security
